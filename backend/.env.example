# Existing backend configuration
PORT=3000
MONGO_URI=mongodb://127.0.0.1:27017/hermarket
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# Required only for AI photo material suggestions. Keep this key on the server.
GEMINI_API_KEY=
GEMINI_VISION_MODEL=gemini-3.1-flash-lite

# Starting points shown to sellers; sellers can change both while calculating.
PRICING_HOURLY_RATE_NPR=150
PRICING_PROFIT_MARGIN_PERCENT=35
